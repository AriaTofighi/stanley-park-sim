# Public source and documentation only. Local builds and research stay local.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/LICENSE.md
!/docs/
!/manifests/
!/pipeline/
!/scripts/
!/unreal/

# Large assets are restored from the release.
/unreal/*
!/unreal/StanleyParkSim.uproject
!/unreal/Source/
!/unreal/Config/
!/unreal/Content/
/unreal/Content/*
!/unreal/Content/Python/
/unreal/Config/DefaultEditorPerProjectUserSettings.ini

/scripts/*
!/scripts/build-editor.ps1
!/scripts/open-seawall-editor.ps1
!/scripts/open-blender-project.ps1
!/scripts/package-windows.ps1
!/scripts/copy-source-data.ps1
!/scripts/record-build-inputs.ps1
!/scripts/restore-assets.ps1
!/scripts/package-release.ps1

**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.cache/
**/node_modules/
**/*.pyc
**/*.blend1
**/*.blend2
**/.env
**/.env.*
**/*.pem
**/*.key
**/credentials.json
/pipeline/blender/render-overview-arguments.json
